# Application
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny

# Model Provider: "ollama" or "anthropic"
MODEL_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
