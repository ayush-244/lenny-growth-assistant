# Application
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny

# Model Provider: "ollama" or "anthropic"
MODEL_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# RAG retrieval
# RAG_TOP_K: number of chunks to retrieve per query (default 5)
RAG_TOP_K=5
# RAG_MIN_SIMILARITY: minimum cosine similarity threshold (0.35 is an initial tunable value, not scientifically optimal)
RAG_MIN_SIMILARITY=0.35
